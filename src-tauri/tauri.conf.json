{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alibi",
  "version": "0.1.0",
  "identifier": "com.kinggrey.alibi",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "alibi",
        "minWidth": 760,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic"]
        },
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright © 2026 lohit-dev",
    "longDescription": "Record daily work and build appraisal evidence. Stored locally in SQLite.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Private local-first work ledger.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
